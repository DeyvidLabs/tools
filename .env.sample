PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# PostgreSQL — docker-compose defaults shown below
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nestjs:nestjs_secret@localhost:5432/nestjs_db

# Optional: used by docker-compose to override postgres defaults
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs_secret
POSTGRES_DB=nestjs_db
POSTGRES_PORT=5432

# CORS — comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:3000

# Google OAuth2 — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# `pnpm dev` (native, no nginx) -> http://localhost:5000/api/auth/google/callback
# `docker compose up` (nginx in front, see docker-compose.yml) -> http://localhost:${NGINX_PORT}/api/auth/google/callback
# Must also be registered as an authorized redirect URI in the Google Cloud console.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# apps/web — origin of the NestJS backend, used only server-side by next.config.ts
# to rewrite /api/* to the backend (same-domain path-based topology, see .secrets/IMP.md)
# Overridden to http://api:5000 inside docker-compose.yml (in-network hostname).
API_ORIGIN=http://localhost:5000

# nginx — host port for the full self-host stack (docker-compose.yml), maps to
# nginx's port 80 inside the container. Not used by `pnpm dev`.
NGINX_PORT=8090

# Pastebin — optional. When set, POST /api/paste accepts expiresIn: "never"
# for requests that send this exact value in the x-paste-admin-token header.
# Not used or exposed anywhere in the web UI — intentionally curl/API-only.
# PASTE_ADMIN_TOKEN=change-me-to-a-long-random-string
